        ],
        "what_would_falsify": "dedicated PG hyperparameter sweep on sparse-reward tasks"
      },
      "module": "s2_strategies",
      "parameters": [],
      "title": "Weak: PG baselines may be undertuned",
      "type": "claim"
    },
    {
      "content": "Experiments cover bandit / single-task / sequence tasks but not multi-step multi-turn agent tasks (SWE-bench, WebArena-full, multi-hop web navigation).",
      "content_hash": "3d40df65f053c25e969abca95a4ce1ffeb48a4cc7a568c29232bf64b620b8382",
      "declaration_index": 1,
      "exported": false,
